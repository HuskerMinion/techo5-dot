# What TECHO5 adds to LibreEcho's mt8163_arm32_defconfig for the Echo 2nd gen (build-kernel-61.sh).
# The local version names the board, so dotimage.py kernel_board() can tell this kernel's board.
CONFIG_LOCALVERSION="-techo5-radar"
CONFIG_LOCALVERSION_AUTO=n
# Partition numbers as on Amazon's kernel: the initramfs makes the misc, system, store and data nodes by
# hand (tools/linux/init), and with the default 8 minors misc would land on the eMMC's boot area.
CONFIG_MMC_BLOCK_MINORS=32
# Go's runtime needs these: without eventfd every Go program (wmtup, echod) dies at its first poll.
CONFIG_EVENTFD=y
CONFIG_TIMERFD=y
CONFIG_SIGNALFD=y
CONFIG_AIO=y
CONFIG_SYSVIPC=y
# The firewall (rootfs/usr/local/sbin/techo5-firewall), with iptables-legacy.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
# The AirPlay 2 session ports, opened only to a sender that reached the receiver first.
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
# Bluetooth bridge (btbridge: /dev/stpbt to hci0 through /dev/vhci) and HID over BLE.
CONFIG_BT_HCIVHCI=y
CONFIG_UHID=y
# zram swap, as the 3.18 images have.
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZO=y
# The privacy and LED lines, through sysfs.
CONFIG_EXPERT=y
CONFIG_GPIO_SYSFS=y
