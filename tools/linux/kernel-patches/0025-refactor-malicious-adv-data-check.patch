# Upstream: 899663be5e75dc0174dc8bda0b5e6826edf0b29a "Bluetooth: refactor malicious adv data check"
# Taken from: linux-4.4.y stable backport 305e92f525450f3e1b5f5c9dc7eadb152d66a082
# CVE: CVE-2021-47620
# 3.18 adaptation: bt_dev_err() does not exist in 3.18: BT_ERR("%s: ...", hdev->name).
#
diff --git a/net/bluetooth/hci_event.c b/net/bluetooth/hci_event.c
--- a/net/bluetooth/hci_event.c
+++ b/net/bluetooth/hci_event.c
@@ -4520,6 +4520,11 @@ static void hci_le_adv_report_evt(struct hci_dev *hdev, struct sk_buff *skb)
 		struct hci_ev_le_advertising_info *ev = ptr;
 		s8 rssi;
 
+		if (ptr > (void *)skb_tail_pointer(skb) - sizeof(*ev)) {
+			BT_ERR("%s: Malicious advertising data.", hdev->name);
+			break;
+		}
+
 		if (ev->length <= HCI_MAX_AD_LENGTH &&
 		    ev->data + ev->length <= skb_tail_pointer(skb)) {
 			rssi = ev->data[ev->length];
@@ -4532,12 +4537,6 @@ static void hci_le_adv_report_evt(struct hci_dev *hdev, struct sk_buff *skb)
 		}
 
 		ptr += sizeof(*ev) + ev->length + 1;
-
-		if (ptr > (void *) skb_tail_pointer(skb) - sizeof(*ev)) {
-			BT_ERR("%s: Malicious advertising data. Stopping processing",
-			       hdev->name);
-			break;
-		}
 	}
 
 	hci_dev_unlock(hdev);
