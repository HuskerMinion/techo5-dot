#!/bin/sh
# wifi-set: change the Wi-Fi network this Dot joins, without Fire OS.
#
#   wifi-set "Network name" "passphrase"     join this network from now on
#   wifi-set --hex <ssid-hex> <psk-hex>      the same, already encoded (what tools/set-wifi.py sends)
#   wifi-set --forget                        go back to the network Fire OS saved
#
# The passphrase is never stored: wpa_passphrase turns it into the 64-hex key wpa_supplicant uses, and
# the name is kept as hex, so no character in either can break the configuration file.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
OWN=/data/techo5-linux/wifi.conf

die() { echo "wifi-set: $*" >&2; exit 1; }
[ -d /data/techo5-linux ] || die "userdata is not mounted"

case "$1" in
--forget)
	rm -f $OWN
	sync
	echo "wifi-set: back to the network Fire OS saved"
	;;
--hex)
	echo "$2" | grep -Eq '^([0-9a-fA-F]{2}){1,32}$' || die "the name must be 1-32 bytes of hex"
	echo "$3" | grep -Eq '^[0-9a-fA-F]{64}$' || die "the key must be 64 hex digits"
	ssid=$2
	psk=$3
	;;
"" | -h | --help)
	sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
	exit 1
	;;
*)
	[ -n "$1" ] || die "no network name"
	[ ${#1} -le 32 ] || die "a network name is at most 32 bytes"
	[ ${#2} -ge 8 ] && [ ${#2} -le 63 ] || die "a WPA passphrase is 8 to 63 characters"
	ssid=$(printf %s "$1" | od -An -v -tx1 | tr -d ' \n')
	psk=$(wpa_passphrase "$1" "$2" | sed -n 's/^[ \t]*psk=\([0-9a-f]\{64\}\)$/\1/p')
	[ -n "$psk" ] || die "wpa_passphrase gave no key"
	;;
esac

if [ "$1" != --forget ]; then
	( umask 077
	  printf 'ssid=%s\npsk=%s\n' "$ssid" "$psk" > $OWN.tmp && mv -f $OWN.tmp $OWN )
	sync
	echo "wifi-set: saved"
fi
techo5-net restart
